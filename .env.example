TELEGRAM_BOT_TOKEN=your-telegram-bot-token
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
DB_PATH=bot.db
# Список Telegram user id, кому разрешено пользоваться ботом.
# Через запятую или пробел. Если пусто/не задано — бот открыт всем.
# Узнать свой id можно у @userinfobot.
ALLOWED_USER_IDS=
# System instruction для Gemini. Пусто или не задано — используется дефолт,
# который просит стандартный Markdown, совместимый с Telegram (его потом
# конвертирует telegramify-markdown в MarkdownV2). Значение `off` полностью
# отключает системную инструкцию.
GEMINI_SYSTEM_INSTRUCTION=
